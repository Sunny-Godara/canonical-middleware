{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Application",
  "type": "object",
  "required": [
    "application_id",
    "citizen",
    "department",
    "application_type",
    "status",
    "schema_version"
  ],
  "properties": {
    "application_id": {
      "type": "string"
    },
    "citizen": {
      "type": "object",
      "required": [
        "citizen_id",
        "name",
        "age"
      ],
      "properties": {
        "citizen_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "age": {
          "type": "integer",
          "minimum": 0
        },
        "email": {
          "type": "string",
          "format": "email"
        }
      }
    },
    "department": {
      "type": "string"
    },
    "application_type": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    }
  }
}